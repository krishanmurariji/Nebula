<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, everywhere. Songs are downloaded over HTTPS and played from a
  local file, so there is no local proxy and no cleartext exception at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
